[Unit]
Description=ScrapeInsight — scrape/extract/analyze demo
After=network-online.target
Wants=network-online.target

[Service]
User=foundry
WorkingDirectory=/opt/demos/scrapeinsight
EnvironmentFile=/opt/demos/scrapeinsight/.env
ExecStart=/opt/demos/scrapeinsight/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8902
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
